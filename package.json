{
  "name": "aidlc-requirements-app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0 <1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run --cwd apps/web build",
    "e2e": "playwright test",
    "e2e:docker": "playwright test -c playwright.docker.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
