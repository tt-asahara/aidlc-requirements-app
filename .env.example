# Validated at startup. Fake mode needs no credentials or model setup.
PORT=8787
# Optional development UI port (use a different port if 5173 is occupied).
WEB_PORT=5173
# Containers bind internally; Compose publishes only to host 127.0.0.1.
AIDLC_APP_BIND_ADDRESS=127.0.0.1
AIDLC_APP_SERVE_WEB=0
# Optional Compose host port, independent of the existing 15176 / 5274 previews.
# AIDLC_APP_DOCKER_PORT=15178

# DB, workspaces, logs and isolated Claude homes remain outside the repository.
AIDLC_APP_DATA_DIR=../aidlc-app-data
# fake is model-free; claude requires separately authorized model credentials.
AIDLC_APP_RUNNER=fake
# Optional synthetic UI scenario (fake only; never a real model/project).
# AIDLC_APP_FAKE_SCENARIO=requirements
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
TURN_BUDGET_USD=5
PROJECT_BUDGET_USD=60
TURN_TIMEOUT_MS=2700000
# UI_POC_BROWSER_EXECUTABLE=/path/to/chromium
AIDLC_APP_GIT_NAME=aidlc-app
AIDLC_APP_GIT_EMAIL=aidlc-app@localhost
AIDLC_APP_DEV_USERS=dev

# Real mode only: existing credentials through the environment or standard file references.
# ANTHROPIC_API_KEY
# Or CLAUDE_CODE_USE_BEDROCK=1 with AWS_REGION, AWS_PROFILE,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN as applicable.
# ANTHROPIC_MODEL
