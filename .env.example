# M1 validates these settings. No credentials or model setup is required.
PORT=8787
# Optional development UI port (use a different port if 5173 is occupied).
WEB_PORT=5173

# DB, workspaces, logs and isolated Claude homes remain outside the repository.
AIDLC_APP_DATA_DIR=../aidlc-app-data
# fake is model-free; claude requires separately authorized model credentials.
AIDLC_APP_RUNNER=fake
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet
TURN_BUDGET_USD=5
PROJECT_BUDGET_USD=60
TURN_TIMEOUT_MS=2700000
# UI_POC_BROWSER_EXECUTABLE=/path/to/chromium
AIDLC_APP_GIT_NAME=aidlc-app
AIDLC_APP_GIT_EMAIL=aidlc-app@localhost
AIDLC_APP_DEV_USERS=dev

# Authentication (later milestones only): provide through the environment.
# ANTHROPIC_API_KEY
# Or CLAUDE_CODE_USE_BEDROCK=1 with AWS_REGION, AWS_PROFILE,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN as applicable.
# ANTHROPIC_MODEL
